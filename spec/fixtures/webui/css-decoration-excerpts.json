    "grids": {
      "1731": [
        "bg_provider = Gtk::CssProvider.new",
        "sheet = case opts[\"Widget Background\"]",
        "        when \"None\"",
        "          \"#{selector} { background: none; }\"",
        "        when \"Solid Color\"",
        "          \"#{selector} { background: none; background-color: #{opts[\"Widget Background Color\"]}; }\"",
        "        when \"Image\"",
        "          <<~CSS",
        "            #{selector} {",
        "              background: none;",
        "              background-color: #{opts[\"Image Background Color\"]};",
        "              background-image: url(\"file:///#{opts[\"Image Location\"]}\");",
        "              background-size: #{opts[\"Image Horizontal Size\"]}% #{opts[\"Image Vertical Size\"]}%;",
        "              background-position: #{opts[\"Image Horizontal Position\"]}% #{opts[\"Image Vertical Position\"]}%;",
        "              background-repeat: no-repeat;",
        "            }",
        "          CSS",
        "        when \"Radial\"",
        "          stops = (1..5).map { |n| opts[\"Radial Color #{n}\"] }.reject { |c| c.to_s.empty? }.join(\", \")",
        "          \"#{selector} { background: radial-gradient(#{opts[\"Radial Shape\"]} at #{opts[\"Radial Horizontal Position\"]}% #{opts[\"Radial Vertical Position\"]}%, #{stops}); }\"",
        "        when \"Linear\"",
        "          stops = (1..5).map { |n| opts[\"Linear Color #{n}\"] }.reject { |c| c.to_s.empty? }.join(\", \")",
        "          \"#{selector} { background: linear-gradient(#{opts[\"Linear Degrees\"]}deg, #{stops}); }\"",
        "        else",
        "          \"\"",
        "        end",
        "bg_provider.load_from_data(sheet)",
        "widget.style_context.add_provider(bg_provider, Gtk::StyleProvider::PRIORITY_APPLICATION)"
      ]
    },
