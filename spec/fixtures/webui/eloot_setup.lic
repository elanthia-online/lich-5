          # Only consulted when both sell_locksmith and sell_locksmith_pool are enabled;
          # decides which is tried first each run. 'pool' preserves pre-existing behavior.
          locksmith_priority: { default: 'pool' },
          locksmith_when_gem_bounty: { default: false },
          always_check_pool: { default: false },
          locksmith_withdraw_amount: { default: 8000 },
