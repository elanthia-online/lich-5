# The CSS decoration corpus is compared as stored bytes (a rebuild must equal
# it byte for byte); never convert its line endings on checkout or commit.
css-decoration.json -text
# Setup fixtures are digest-checked as stored bytes (LF, CRLF or mixed);
# never convert their line endings on checkout or commit.
*_setup.lic -text
# css-decoration.json records this file's whole-file SHA-256 as audit_sha256.
css-provenance.json -text
# The synthetic excerpt text that the corpus builder embeds in css-decoration.json.
# Together with css-decoration.json, css-provenance.json and *_setup.lic above, these are
# all the -text files here.
css-decoration-excerpts.json -text
